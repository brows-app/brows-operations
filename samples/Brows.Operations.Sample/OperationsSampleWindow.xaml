<Window x:Class="Brows.OperationsSampleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brows Operations · Work in motion"
        Height="900" Width="1440" MinHeight="760" MinWidth="1200"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True" Loaded="Window_Loaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/OperationsTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="BROWS OPERATIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
        <TextBlock Text="Work in motion" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,6"/>
        <TextBlock Text="Watch tasks unfold, report progress, and handle errors in one place."
                   FontSize="13" Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
        <TextBlock Text="WPF SAMPLE" HorizontalAlignment="Right" FontSize="10"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
        <Button x:Name="ShowcaseButton" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                Click="RunShowcase_Click" ToolTip="Start nested work, a cancellable task, and a child failure together.">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#x25B6;" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Run showcase"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid x:Name="ScenarioPanel" Grid.Row="1" IsEnabled="False">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource ScenarioCardStyle}">
        <StackPanel>
          <TextBlock Text="01  /  HIERARCHY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
          <TextBlock Text="Explore a hierarchy" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,4"/>
          <TextBlock Text="Parents, children, and batches." FontSize="12" Foreground="{StaticResource MutedBrush}"/>
          <WrapPanel>
            <Button Style="{StaticResource ScenarioButtonStyle}" Content="Nested workflow" Click="RunNested_Click"/>
            <Button Style="{StaticResource ScenarioButtonStyle}" Content="Parallel batch" Click="RunBatch_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource ScenarioCardStyle}">
        <StackPanel>
          <TextBlock Text="02  /  PROGRESS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
          <TextBlock Text="Follow the progress" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,4"/>
          <TextBlock Text="Live updates and cooperative cancellation." FontSize="12" Foreground="{StaticResource MutedBrush}"/>
          <WrapPanel>
            <Button Style="{StaticResource ScenarioButtonStyle}" Content="Set &amp; add" Click="RunProgressUpdates_Click"/>
            <Button Style="{StaticResource ScenarioButtonStyle}" Content="Cancel a task" Click="RunCancellable_Click"/>
            <Button Style="{StaticResource ScenarioButtonStyle}" Content="Successful task" Click="RunSuccess_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Style="{StaticResource ScenarioCardStyle}">
        <StackPanel>
          <TextBlock Text="03  /  ERRORS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
          <TextBlock Text="Handle failures" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,4"/>
          <TextBlock Text="Errors stay available for inspection." FontSize="12" Foreground="{StaticResource MutedBrush}"/>
          <WrapPanel>
            <Button Style="{StaticResource ScenarioButtonStyle}" Content="Child fails" Click="RunChildFailure_Click"/>
            <Button Style="{StaticResource ScenarioButtonStyle}" Content="Parent fails" Click="RunParentFailure_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,14,0,16" FontSize="12"
               Foreground="{StaticResource MutedBrush}" Text="Preparing the demo…" TextWrapping="Wrap"/>

    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1" CornerRadius="12" Padding="20,16,20,8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Operation activity" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="10,4" Margin="12,0,0,0">
              <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                         Text="{Binding Operator.Operations.Count, ElementName=OperationView, FallbackValue=0,
                                        StringFormat={}{0} tracked}"/>
            </Border>
          </StackPanel>
          <Button x:Name="ClearFinishedButton" Content="Clear finished" HorizontalAlignment="Right"
                  Click="ClearFinished_Click" ToolTip="Remove completed operations that remain after a failure.">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="Padding" Value="12,7"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Operator.Operations.Count, ElementName=OperationView, FallbackValue=0}" Value="0">
                    <Setter Property="IsEnabled" Value="False"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </Grid>

        <Grid Grid.Row="1">
          <brows:OperatorControl x:Name="OperationView" Style="{StaticResource ShowcaseOperatorStyle}"/>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Operator.Operations.Count, ElementName=OperationView, FallbackValue=0}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentSoftBrush}"
                    HorizontalAlignment="Center" Margin="0,0,0,18">
              <TextBlock Text="&#x2713;" FontSize="28" Foreground="{StaticResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Ready for the next task" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Start a scenario above, or run the showcase to see it all together."
                       FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,6">
          <Grid>
            <TextBlock Text="Long-running work appears after a short delay." FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="Working" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
              <Ellipse Width="6" Height="6" Fill="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="18,0,6,0"/>
              <TextBlock Text="Needs attention" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <TextBlock Grid.Row="4" Text="Successful tasks clear automatically. Failed tasks stay until you remove them."
               FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="2,16,0,0"/>
  </Grid>
</Window>
