<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Brows.Operations.Windows;component/Resources/Styles.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <SolidColorBrush x:Key="CanvasBrush" Color="#F1F5F9"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="InkBrush" Color="#172B43"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#617287"/>
  <SolidColorBrush x:Key="StrokeBrush" Color="#DCE5EE"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#087F78"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6F4F1"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#B93838"/>
  <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FFF0EE"/>

  <Style x:Key="KeyboardFocusStyle" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="10" RadiusY="10"
                     Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeDashArray="2,2"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ActionButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#D1EAE5"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
        <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Padding" Value="20,13"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#066D67"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#055D58"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ScenarioButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
    <Setter Property="Margin" Value="0,10,8,0"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>
  <Style x:Key="ScenarioCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="20,18"/>
  </Style>

  <!-- Headers receive header text; content templates receive the individual cell value. -->
  <DataTemplate x:Key="ColumnHeaderTemplate">
    <TextBlock Text="{Binding}" Margin="12,8,12,16" FontSize="11" FontWeight="SemiBold"
               Foreground="{StaticResource MutedBrush}"/>
  </DataTemplate>
  <DataTemplate x:Key="DepthHeaderTemplate">
    <TextBlock Text="Level" Margin="8,8,8,16" FontSize="10" FontWeight="SemiBold"
               Foreground="{StaticResource MutedBrush}"/>
  </DataTemplate>
  <DataTemplate x:Key="DepthCellTemplate">
    <TextBlock Margin="8,14" Width="30" VerticalAlignment="Center" TextAlignment="Center"
               FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" ToolTip="{Binding}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Text" Value="{Binding}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="">
              <Setter Property="Text" Value="&#x2022;"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </DataTemplate>
  <DataTemplate x:Key="NameCellTemplate">
    <TextBlock Text="{Binding}" Margin="12,14" Width="226" VerticalAlignment="Center"
               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
               TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
  </DataTemplate>
  <DataTemplate x:Key="DataCellTemplate">
    <TextBlock Text="{Binding}" Margin="12,14" Width="226" VerticalAlignment="Center"
               FontSize="12" Foreground="{StaticResource MutedBrush}"
               TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
  </DataTemplate>
  <DataTemplate x:Key="ProgressCellTemplate">
    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6"
            Margin="12,9" Padding="8,5" Width="76" VerticalAlignment="Center">
      <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                 Foreground="{StaticResource AccentBrush}" TextAlignment="Center"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="TargetCellTemplate">
    <TextBlock Text="{Binding}" Margin="12,14" Width="76" VerticalAlignment="Center"
               FontSize="12" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
               TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
  </DataTemplate>
  <!-- Error templates receive the exception itself. -->
  <DataTemplate x:Key="ExceptionTemplate">
    <Border Background="{StaticResource ErrorSoftBrush}" CornerRadius="6" Padding="10,8"
            Margin="12,6" MaxWidth="360" HorizontalAlignment="Left" VerticalAlignment="Center">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="!" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource ErrorBrush}" ToolTip="{Binding Message}"/>
      </Grid>
    </Border>
  </DataTemplate>
  <Style x:Key="OperationProgressStyle" TargetType="ProgressBar">
    <Setter Property="Height" Value="8"/>
    <Setter Property="MinWidth" Value="140"/>
    <Setter Property="Margin" Value="12,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="PART_Track" ClipToBounds="True">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
            <!-- Canvas prevents the indicator's calculated width from increasing the
                 desired width when the outer scroll viewer measures horizontally. -->
            <Canvas>
              <Border x:Name="PART_Indicator" Height="{Binding ActualHeight, ElementName=PART_Track}"
                      Background="{TemplateBinding Foreground}" CornerRadius="4"/>
            </Canvas>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OperationScrollStyle" TargetType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="CanContentScroll" Value="False"/>
    <Setter Property="Padding" Value="0,0,0,8"/>
  </Style>
  <!-- Keep the library's implicit row template. OperatorControl owns the scrolling. -->
  <DataTemplate x:Key="OperationListTemplate">
    <ListBox ItemsSource="{Binding}" BorderThickness="0" Background="Transparent" Padding="0"
             AlternationCount="2" HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
      <ListBox.Template>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter/>
        </ControlTemplate>
      </ListBox.Template>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                  <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
              <Setter Property="Background" Value="#F7F9FC"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#EDF3F8"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            </Trigger>
            <DataTrigger Binding="{Binding CompleteWithError}" Value="True">
              <Setter Property="Background" Value="#FFF7F5"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>
  </DataTemplate>

  <Style x:Key="OperationButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
    <Setter Property="Margin" Value="6,7,8,7"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>
  <!-- Custom button styles supply Content; OperatorControl supplies the commands. -->
  <Style x:Key="CancelOperationButtonStyle" TargetType="Button" BasedOn="{StaticResource OperationButtonStyle}">
    <Setter Property="Content" Value="Cancel"/>
  </Style>
  <Style x:Key="RemoveOperationButtonStyle" TargetType="Button" BasedOn="{StaticResource OperationButtonStyle}">
    <Setter Property="Content" Value="Remove"/>
    <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
    <Setter Property="BorderBrush" Value="#F3D3D0"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#FDE3DF"/>
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#FAD1CB"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ShowcaseOperatorStyle" TargetType="brows:OperatorControl"
         BasedOn="{StaticResource {x:Type brows:OperatorControl}}">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="OperationItemsTemplate" Value="{StaticResource OperationListTemplate}"/>
    <Setter Property="OperationErrorTemplate" Value="{StaticResource ExceptionTemplate}"/>
    <Setter Property="OperationProgressBarStyle" Value="{StaticResource OperationProgressStyle}"/>
    <Setter Property="OperationScrollViewerStyle" Value="{StaticResource OperationScrollStyle}"/>
    <Setter Property="OperationCancelButtonStyle" Value="{StaticResource CancelOperationButtonStyle}"/>
    <Setter Property="OperationRemoveButtonStyle" Value="{StaticResource RemoveOperationButtonStyle}"/>
    <Setter Property="OperationDepthHeaderTemplate" Value="{StaticResource DepthHeaderTemplate}"/>
    <Setter Property="OperationNameHeaderTemplate" Value="{StaticResource ColumnHeaderTemplate}"/>
    <Setter Property="OperationDataHeaderTemplate" Value="{StaticResource ColumnHeaderTemplate}"/>
    <Setter Property="OperationProgressHeaderTemplate" Value="{StaticResource ColumnHeaderTemplate}"/>
    <Setter Property="OperationTargetHeaderTemplate" Value="{StaticResource ColumnHeaderTemplate}"/>
    <Setter Property="OperationDepthContentTemplate" Value="{StaticResource DepthCellTemplate}"/>
    <Setter Property="OperationNameContentTemplate" Value="{StaticResource NameCellTemplate}"/>
    <Setter Property="OperationDataContentTemplate" Value="{StaticResource DataCellTemplate}"/>
    <Setter Property="OperationProgressContentTemplate" Value="{StaticResource ProgressCellTemplate}"/>
    <Setter Property="OperationTargetContentTemplate" Value="{StaticResource TargetCellTemplate}"/>
  </Style>
</ResourceDictionary>
